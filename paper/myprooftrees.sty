\RequirePackage{xparse}

\NewDocumentCommand\ruleLabel{m}{\textup{\textsc{#1}}}
\NewDocumentCommand\inferLabel{O{\scriptsize}m}{\mbox{#1\normalfont{\ruleLabel{#2}}}}
\NewDocumentCommand\bussRL{o}{%
    \IfValueT{#1}{%
        \RightLabel{\inferLabel{#1}}
    }
}
\RequirePackage{bussproofs}
\NewDocumentCommand\bussAx{o m}{\AxiomC{}\bussRL[#1]\UnaryInfC{\ensuremath{#2}}}
\def\bussAs#1{\AxiomC{\ensuremath{#1}}}
\def\bussAsBelow#1{\noLine\UnaryInfC{\ensuremath{#1}}}
\NewDocumentCommand\bussU{o m}{\bussRL[#1]\UnaryInfC{\ensuremath{#2}}}
\NewDocumentCommand\bussB{o m}{\bussRL[#1]\BinaryInfC{\ensuremath{#2}}}
\NewDocumentCommand\bussT{o m}{\bussRL[#1]\TrinaryInfC{\ensuremath{#2}}}
\NewDocumentCommand\bussQ{o m}{\bussRL[#1]\QuaternaryInfC{\ensuremath{#2}}}
\def\bussDisplay{\DisplayProof}
\NewDocumentEnvironment{bussproof}{o D(){b}}{%
    \begin{array}[#2]{@{}l@{}}
        \IfValueT{#1}{%
            \inferLabel{#1}
            \\
        }%
        \bottomAlignProof
}{%
        \bussDisplay%
    \end{array}
}
