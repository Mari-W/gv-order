opam-version: "2.0"
name: "gv-order"
version: "dev"
synopsis:
  "GV≺, session types with orders between points, deadlock and lock freedom by logical relations, in Rocq"
maintainer: "weidner@cs.uni-freiburg.de"
authors: "weidner@cs.uni-freiburg.de"
homepage: "https://github.com/Mari-W/gv-order"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "conf-gmp" {= "5"}
  "conf-linux-libc-dev" {= "0"}
  "conf-pkg-config" {= "5"}
  "dune" {= "3.23.1"}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.8"}
  "rocq-core" {= "9.2.0"}
  "rocq-runtime" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "rocq-stdpp" {= "1.13.0"}
  "zarith" {= "1.14"}
]
build: [make "-j%{jobs}%"]
pin-depends: [
  "rocq-stdpp.1.13.0"
  "https://gitlab.mpi-sws.org/iris/stdpp/-/archive/stdpp-1.13.0/stdpp-stdpp-1.13.0.tar.gz"
]