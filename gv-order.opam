opam-version: "2.0"
name: "gv-order"
version: "dev"
synopsis: "GV≺, session types with orders between points, deadlock and lock freedom by logical relations, in Rocq"
maintainer: "weidner@cs.uni-freiburg.de"
authors: ["weidner@cs.uni-freiburg.de"]
homepage: "https://github.com/Mari-W/gv-order"
build: [
  [make "-j%{jobs}%"]
]
depends: [
  "ocaml" {>= "4.14"}
  "rocq-core" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "rocq-stdpp" {= "1.13.0"}
]
