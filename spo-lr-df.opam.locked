opam-version: "2.0"
name: "spo-lr-df"
version: "dev"
synopsis:
  "Deadlock freedom by strict partial orders and a logical relation, in Rocq"
maintainer: "weidner@cs.uni-freiburg.de"
authors: "weidner@cs.uni-freiburg.de"
homepage: "https://github.com/Mari-W/spo-lr-df"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "conf-gmp" {= "5"}
  "conf-linux-libc-dev" {= "0"}
  "conf-pkg-config" {= "5"}
  "dune" {= "3.23.1"}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.8"}
  "rocq-core" {= "9.2.0"}
  "rocq-runtime" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "rocq-stdpp" {= "1.13.0"}
  "zarith" {= "1.14"}
]
build: [make "-j%{jobs}%"]
pin-depends: [
  "rocq-stdpp.1.13.0"
  "https://gitlab.mpi-sws.org/iris/stdpp/-/archive/stdpp-1.13.0/stdpp-stdpp-1.13.0.tar.gz"
]