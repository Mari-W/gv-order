λ (N : nat) (W : world) (n : Ix) (Σ : senv) (T : ty) (a : lfstate),
  a ∈ S^{N,W} _ n⟦Σ ⊢ T⟧
     : nat → world → Ix → senv → ty → lfstate → Prop
λ (N : nat) (W : world) (Σ : senv) (p : proc) (T : ty), Σ ⊪^N _W p : T
     : nat → world → senv → proc → ty → Prop
idle_dual
     : ∀ S S' : sty, sequiv S' (dual S) → idle S ↔ idle S'
lfsoup_step
     : ∀ (N : nat) (W : world) (T : ty) (a : lfstate) 
         (n : Ix) (ev : event) (q' : config),
         a ∈ S^{N,W} _ n⟦∅ ⊢ T⟧
         → itstep (s_q a) ev q'
           → ∀ lv : ord, olt lv n → lf_next N a ev q' ∈ S^{N,W} _ lv⟦∅ ⊢ T⟧
soup_no_tau_divergence
     : ∀ (N : nat) (W : world) (T : ty) (a : lfstate),
         (∀ n : Ix, a ∈ S^{N,W} _ n⟦∅ ⊢ T⟧)
         → no_tau_divergence (erase (s_q a))
lf_adequacy
     : ∀ (N : nat) (W : world) (T : ty) (p : proc),
         strict W → wfworld W → ∅ ⊪^N _W p : T → lock_free p
lf_thread_progress
     : ∀ (N : nat) (W : world) (T : ty) (p : proc),
         strict W
         → wfworld W
           → ∅ ⊪^N _W p : T
             → ∀ (r : nat → config) (l : nat → option event),
                 erase (r 0) = p
                 → maximal r l → wfair r l → thread_progress_run r l
λ (N : nat) (W : world) (Σ : senv) (p : proc) (T : ty), Σ ⊩^N _ W p : T
     : nat → world → senv → proc → ty → Prop
lf_fundamental
     : ∀ (N : nat) (W : world) (Σ : senv) (p : proc) (T : ty),
         Σ ⊩^N _ W p : T → Σ ⊪^N _W p : T
lf_soundness
     : ∀ (N : nat) (W : world) (p : proc) (T : ty),
         wfworld W → ∅ ⊩^N _ W p : T → lock_free p
