λ (N : nat) (W : world) (n : Ix) (Σ : senv) (T : ty) (a : lfstate),
  a ∈ S^{N,W} _ n⟦Σ ⊢ T⟧
     : nat → world → Ix → senv → ty → lfstate → Prop
λ (N : nat) (W : world) (Σ : senv) (p : proc) (T : ty), Σ ⊪^N _W p : T
     : nat → world → senv → proc → ty → Prop
idle_dual
     : ∀ S S' : sty, sequiv S' (dual S) → idle S ↔ idle S'
lfsoup_step
     : ∀ (N : nat) (W : world) (T : ty) (a : lfstate) 
         (n : Ix) (ev : event) (q' : config),
         a ∈ S^{N,W} _ n⟦∅ ⊢ T⟧
         → itstep (s_q a) ev q'
           → ∀ lv : ord,
               olt lv n
               → ∃ tc : tchoice,
                   tsum_ok (Some N) (tc_m1 tc) (tc_m2 tc)
                   ∧ s_W a ⊑ s_W (lf_next tc a ev q')
                     ∧ lf_next tc a ev q' ∈ S^{N,W} _ lv⟦∅ ⊢ T⟧
soup_no_tau_divergence
     : ∀ (N : nat) (W : world) (T : ty) (a : lfstate),
         (∀ n : Ix, a ∈ S^{N,W} _ n⟦∅ ⊢ T⟧)
         → no_tau_divergence (erase (s_q a))
lf_adequacy
     : excluded_middle
       → functional_choice
         → ∀ (N : nat) (W : world) (T : ty) (p : proc),
             ∅ ⊪^N _W p : T → lock_free p
lf_thread_progress
     : excluded_middle
       → functional_choice
         → ∀ (N : nat) (W : world) (T : ty) (p : proc),
             ∅ ⊪^N _W p : T
             → ∀ (r : nat → config) (l : nat → option event),
                 erase (r 0) = p
                 → maximal r l → wfair r l → thread_progress_run r l
λ (N : nat) (W : sworld) (Σ : senv) (p : proc) (T : ty), Σ ⊩^N _ W p : T
     : nat → sworld → senv → proc → ty → Prop
lf_fundamental
     : ∀ (N : nat) (W : sworld) (Σ : senv) (p : proc) (T : ty),
         Σ ⊩^N _ W p : T → lf_sems N W Σ p T
lf_soundness
     : ∀ (N : nat) (W : sworld) (p : proc) (T : ty),
         excluded_middle → functional_choice → ∅ ⊩^N _ W p : T → lock_free p
