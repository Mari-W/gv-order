λ (κ : ctable) (n : Ix) (W : world) (Θ : senv) (T : ty) (v : expr),
  v ∈ V[κ]^W _ n⟦Θ ⊢ T⟧
     : ctable → Ix → vrel
λ (κ : ctable) (n : Ix) (W : world) (Θ : senv) (T : ty) 
  (F : gset point) (e : expr), e ∈ E[κ]^W _ n⟦Θ ⊢ T⟧^F
     : ctable → Ix → erel
λ (κ : ctable) (n : Ix) (W : world) (Σ : senv) (T : ty) (p : proc),
  p ∈ P[κ]^W _ n⟦Σ ⊢ T⟧
     : ctable → Ix → prel
λ (n : Ix) (W : world) (Θ : senv) (T : ty) (v : expr), v ∈ V^W _ n⟦Θ ⊢ T⟧
     : Ix → vrel
λ (n : Ix) (W : world) (Θ : senv) (T : ty) (F : gset point) (e : expr),
  e ∈ E^W _ n⟦Θ ⊢ T⟧^F
     : Ix → erel
λ (n : Ix) (W : world) (Σ : senv) (T : ty) (p : proc), p ∈ P^W _ n⟦Σ ⊢ T⟧
     : Ix → prel
λ (n : Ix) (W : world) (Θ : senv) (T : ty) (v : expr),
  v ∈ V[live]^W _ n⟦Θ ⊢ T⟧
     : Ix → vrel
λ (W : world) (Θ : senv) (F : gset point) (t : expr), ready _ W(Θ ∣ F, t)
     : world → senv → gset point → expr → Prop
λ (W : world) (Σ : senv) (p : proc), ready _ W(Σ, p)
     : world → senv → proc → Prop
λ (W : world) (Σ : senv) (p : proc) (T : ty), Σ ⊨_W p : T
     : world → senv → proc → ty → Prop
λ (W : world) (Σ : senv) (p : proc) (T : ty), Σ ⊫_W p : T
     : world → senv → proc → ty → Prop
adequacy
     : ∀ (W : world) (T : ty) (p : proc), ∅ ⊨_W p : T → deadlock_free p
live_adequacy
     : ∀ (W : world) (T : ty) (p : proc),
         ∅ ⊫_W p : T → deadlock_free p ∧ no_tau_divergence p
