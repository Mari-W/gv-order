λ (N : fuel) (n : Ix) (σ : rty) (c : fuel) (Π : penv) (φ : cenv) (e : expr),
  e ∈ F^N _ n⟦σ ▷ c⟧(Π, φ)
     : fuel → Ix → rty → fuel → penv → cenv → expr → Prop
λ (N : fuel) (n : Ix) (σ : rty) (Π : penv) (φ : cenv) (v : expr),
  v ∈ FV^N _ n⟦σ⟧(Π, φ)
     : fuel → Ix → rty → penv → cenv → expr → Prop
FuelE_bind
     : ∀ (n : Ix) (N : fuel) (σ1 σ : rty) (Π1 : penv) 
         (φ1 : cenv) (ΠK : penv) (φK : cenv) (c1 d : fuel) 
         (K : ectx) (e : expr),
         ectx_ok K
         → dom Π1 = dom φ1
           → dom ΠK = dom φK
             → dom φ1 ## dom φK
               → fabove c1 ΠK φK
                 → fle c1 d
                   → fkont n N σ1 σ c1 d ΠK φK K
                     → e ∈ F^N _ n⟦σ1 ▷ c1⟧(Π1, φ1)
                       → efill K e ∈ F^N _ n⟦σ ▷ d⟧(
                       Π1 ∪ ΠK, φ1 ∪ φK)
FuelE_mono
     : ∀ (n : Ix) (N : fuel) (σ : rty) (d d' : fuel) 
         (Π : penv) (φ φ' : cenv) (e : expr),
         cle φ φ'
         → fle d d' → e ∈ F^N _ n⟦σ ▷ d⟧(Π, φ) → e ∈ F^N _ n⟦σ ▷ d'⟧(Π, φ')
Vfuel_age
     : ∀ (N : fuel) (n : Ix) (c : fuel) (T T' : ty) 
         (Π : penv) (φ : cenv) (v : expr),
         tage c T T'
         → v ∈ FV^N _ n⟦RTy T⟧(Π, φ)
           → v ∈ FV^N _ n⟦RTy T'⟧(Π, fminus c <$> φ)
