# Hooks into the generated Makefile (included by it).

# The lexer test of Appendix A: every token parses (checked by the build)
# and prints as written (checked here against test/Lexer.expected).
.PHONY: test
test: test/Lexer.vo test/LangNotations.vo test/TypeNotations.vo test/RelationNotations.vo test/FuelNotations.vo test/CompatNotations.vo test/CostNotations.vo
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/Lexer.v 2>/dev/null | diff -u test/Lexer.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/LangNotations.v 2>/dev/null | diff -u test/LangNotations.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/TypeNotations.v 2>/dev/null | diff -u test/TypeNotations.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/RelationNotations.v 2>/dev/null | diff -u test/RelationNotations.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/FuelNotations.v 2>/dev/null | diff -u test/FuelNotations.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/CostNotations.v 2>/dev/null | diff -u test/CostNotations.expected -
	"$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) test/CompatNotations.v 2>/dev/null | diff -u test/CompatNotations.expected -
	@echo "notation tests: printed forms match test/*.expected"

# Every result listed in CheckAll.v is closed under the global context.
.PHONY: check
check: CheckAll.vo
	@out=$$("$(COQBIN)rocq" c $(COQMF_COQLIBS_NOML) CheckAll.v 2>/dev/null); \
	n=$$(printf '%s\n' "$$out" | grep -c 'Closed under the global context'); \
	m=$$(grep -c '^Print Assumptions' CheckAll.v); \
	echo "CheckAll: $$n of $$m results closed under the global context"; \
	test "$$n" = "$$m"
